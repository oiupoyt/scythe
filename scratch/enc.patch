+                    (*bgra_frame).width = *width as i32;
+                    (*bgra_frame).height = *height as i32;
+                    av_frame_get_buffer(bgra_frame, 32);
+
+                    let bgra_stride = (*bgra_frame).linesize[0] as usize;
+                    for y in 0..(*height as usize) {
