# Maintainer: oiupoyt
pkgname=vrec-git
pkgver=0.1.0
pkgrel=1
pkgdesc="High-performance GPU hardware screen recorder and instant replay overlay for Wayland and X11"
arch=('x86_64')
url="https://github.com/oiupoyt/vrec"
license=('MIT' 'Apache-2.0')
depends=('ffmpeg' 'pipewire' 'gtk3' 'gtk-layer-shell' 'libpulse' 'libva' 'libxcb')
makedepends=('cargo' 'git' 'pkgconf' 'clang')
provides=('vrec')
conflicts=('vrec')
source=("git+https://github.com/oiupoyt/vrec.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/vrec"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.1.0"
}

build() {
    cd "$srcdir/vrec"
    cargo build --release --locked
}

package() {
    cd "$srcdir/vrec"
    install -Dm755 target/release/vrec-daemon "$pkgdir/usr/bin/vrec-daemon"
    install -Dm755 target/release/vrec-ui "$pkgdir/usr/bin/vrec-ui"
    install -Dm644 packaging/vrec.desktop "$pkgdir/usr/share/applications/vrec.desktop"
}
